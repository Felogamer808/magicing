# dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/build
next-env.d.ts

# producción
*.tsbuildinfo

# entorno
.env
.env*.local

# vercel
.vercel

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# editores
.vscode/*
!.vscode/extensions.json
.idea

# claude code — config local por máquina (launch.json sí se versiona)
.claude/settings.local.json

# planillas y normas: no se versionan (tamaño + copyright de las normas)
*.xlsx
*.xlsm
*.pdf

# El manual de Jiménez Montoya es un libro con derechos de autor: la skill se usa
# localmente pero no puede subirse al repositorio. La del Código Estructural sí
# va versionada, porque es texto legal oficial.
.claude/skills/jimenez-montoya/

# ANSI/AISC 360-16 es una norma con copyright del American Institute of Steel
# Construction, no legislación: mismo criterio que Jiménez Montoya. Los scripts
# de scripts/normas/ sí se versionan; el texto que producen, no.
scripts/normas/salida/
.claude/skills/aisc-360/
.env*
