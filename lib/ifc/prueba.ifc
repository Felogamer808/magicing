ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME('prueba.ifc','2026-10-12T00:00:00',('MagicIng'),('MagicIng'),'escrito a mano','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Unidades en mm, como exporta Revit. */
#1=IFCPROJECT('0YvctVUKr0kugbFTf53O9L',$,'Prueba MagicIng',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#23=IFCDIRECTION((0.,0.,1.));
#24=IFCDIRECTION((1.,0.,0.));
#25=IFCDIRECTION((0.,1.,0.));
#26=IFCAXIS2PLACEMENT2D(#27,$);
#27=IFCCARTESIANPOINT((0.,0.));
/* Estructura espacial: sitio, edificio y dos niveles. */
#30=IFCSITE('3BoQ5ihxL5bwVYzZx9ka9P',$,'Sitio',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#32=IFCBUILDING('1xS3BCk291UvhgP2a6eflN',$,'Edificio',$,$,#33,$,$,.ELEMENT.,$,$,$);
