#34=IFCBUILDINGSTOREY('2nGy8uYKX9qwm6dA0bLqTb',$,'Nivel 1',$,$,#35,$,$,.ELEMENT.,0.);
#35=IFCLOCALPLACEMENT(#33,#21);
#36=IFCBUILDINGSTOREY('0zGkQv8Wf3FBnF$jvAvd4k',$,'Nivel 2',$,$,#37,$,$,.ELEMENT.,3000.);
#37=IFCLOCALPLACEMENT(#33,#38);
#38=IFCAXIS2PLACEMENT3D(#39,$,$);
#39=IFCCARTESIANPOINT((0.,0.,3000.));
#40=IFCRELAGGREGATES('1PNTxIrv5Dfu0Ze_wFqVdn',$,$,$,#1,(#30));
#41=IFCRELAGGREGATES('2Rx5r9Mwf7a8kBaVePnS$v',$,$,$,#30,(#32));
#42=IFCRELAGGREGATES('0ByGfSxw1AXQ3NbLu9a6yP',$,$,$,#32,(#34,#36));
/* V-101: viga 200 x 500, 5 m a lo largo de X, apoyada sobre los dos pilares. */
#100=IFCBEAM('2O2Fr$t4X7Zf8NOew3FLOH',$,'V-101',$,$,#101,#102,'101',.BEAM.);
#101=IFCLOCALPLACEMENT(#37,#21);
#102=IFCPRODUCTDEFINITIONSHAPE($,$,(#103));
#103=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#104));
#104=IFCEXTRUDEDAREASOLID(#105,#106,#23,5000.);
#105=IFCRECTANGLEPROFILEDEF(.AREA.,$,#26,200.,500.);
#106=IFCAXIS2PLACEMENT3D(#107,#24,#25);
#107=IFCCARTESIANPOINT((0.,0.,-250.));
/* P-1: pilar circular de 300 mm de diámetro. */
#110=IFCCOLUMN('1hqIFTRjfV6AWq_bMtnZwI',$,'P-1',$,$,#111,#112,'111',.COLUMN.);
#111=IFCLOCALPLACEMENT(#35,#21);
#112=IFCPRODUCTDEFINITIONSHAPE($,$,(#113));
#113=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#114));
#114=IFCEXTRUDEDAREASOLID(#115,#21,#23,2500.);
#115=IFCCIRCLEPROFILEDEF(.AREA.,$,#26,150.);
/* P-2: pilar rectangular 300 x 400. */
#120=IFCCOLUMN('3Ia2qK0Mz9a8Wq3Ywm_K1v',$,'P-2',$,$,#121,#122,'121',.COLUMN.);
#121=IFCLOCALPLACEMENT(#35,#123);
#122=IFCPRODUCTDEFINITIONSHAPE($,$,(#124));
#123=IFCAXIS2PLACEMENT3D(#125,$,$);
#124=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#126));
#125=IFCCARTESIANPOINT((5000.,0.,0.));
#126=IFCEXTRUDEDAREASOLID(#127,#21,#23,2500.);
#127=IFCRECTANGLEPROFILEDEF(.AREA.,$,#26,300.,400.);
/* L-1: losa de 200 mm sobre el nivel 2, contorno arbitrario. */
#130=IFCSLAB('0dO0eYwzT3VAVxA4fJmY3F',$,'L-1',$,$,#131,#132,'131',.FLOOR.);
#131=IFCLOCALPLACEMENT(#37,#21);
#132=IFCPRODUCTDEFINITIONSHAPE($,$,(#133));
#133=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#134));
#134=IFCEXTRUDEDAREASOLID(#135,#21,#23,200.);
#135=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#136);
#136=IFCPOLYLINE((#137,#138,#139,#140,#137));
#137=IFCCARTESIANPOINT((-150.,-2000.));
#138=IFCCARTESIANPOINT((5150.,-2000.));
#139=IFCCARTESIANPOINT((5150.,200.));
#140=IFCCARTESIANPOINT((-150.,200.));
/* M-1: muro de 200 mm de espesor, 5 m de largo y 2,5 m de alto. */
#150=IFCWALL('1kBcPzxkr4JQ8kQXJ9gGg6',$,'M-1',$,$,#151,#152,'151',.STANDARD.);
#151=IFCLOCALPLACEMENT(#35,#153);
#152=IFCPRODUCTDEFINITIONSHAPE($,$,(#154));
#153=IFCAXIS2PLACEMENT3D(#155,$,$);
#154=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#156));
#155=IFCCARTESIANPOINT((2500.,-2000.,0.));
#156=IFCEXTRUDEDAREASOLID(#157,#21,#23,2500.);
#157=IFCRECTANGLEPROFILEDEF(.AREA.,$,#26,5000.,200.);
/* Z-1: zapata de 1,50 x 1,50 y 600 mm de canto bajo P-1. */
#160=IFCFOOTING('2wN6uZ6xD0uQyq9bQkKfE3',$,'Z-1',$,$,#161,#162,'161',.PAD_FOOTING.);
#161=IFCLOCALPLACEMENT(#35,#163);
#162=IFCPRODUCTDEFINITIONSHAPE($,$,(#164));
#163=IFCAXIS2PLACEMENT3D(#165,$,$);
#164=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#166));
#165=IFCCARTESIANPOINT((0.,0.,-600.));
#166=IFCEXTRUDEDAREASOLID(#167,#21,#23,600.);
#167=IFCRECTANGLEPROFILEDEF(.AREA.,$,#26,1500.,1500.);
/* Riostra sin Name, sólo con Tag, y fuera de los niveles (cuelga del edificio). */
#170=IFCMEMBER('0q7c9YtUzEPhPZ8bh2b1rB',$,$,$,$,#171,$,'55001',.BRACE.);
#171=IFCLOCALPLACEMENT(#33,#21);
/* Una puerta: no es estructura, se saltea. */
#180=IFCDOOR('3vB2YO$MX4xv5uCqZZG05x',$,'Puerta 1',$,$,#181,$,'181',2100.,900.,.DOOR.,.SINGLE_SWING_LEFT.,$);
#181=IFCLOCALPLACEMENT(#35,#21);
/* Un GlobalId repetido (exportación defectuosa): entra una sola vez. */
#190=IFCBEAM('2O2Fr$t4X7Zf8NOew3FLOH',$,'V-101 duplicada',$,$,#101,$,'191',.BEAM.);
/* VR4: viga 300 x 450 como la exporta Revit. El perfil se apoya con su X
   vertical (XDim = 450 es la altura), la pieza va girada en planta, el cuerpo
   está recortado (Clipping) y el Name es "Familia:Tipo:Id". La Marca viene en
   el conjunto de propiedades de Revit "Identity Data". */
#300=IFCBEAM('1Yb3lFz0j4_O9qWUcQ7vF2',$,'Solid Wall - Rectangular Beam:300x450:999',$,$,#301,#302,'999',$);
#301=IFCLOCALPLACEMENT(#37,#303);
#302=IFCPRODUCTDEFINITIONSHAPE($,$,(#305));
#303=IFCAXIS2PLACEMENT3D(#304,#23,#25);
#304=IFCCARTESIANPOINT((0.,-2000.,0.));
#305=IFCSHAPEREPRESENTATION(#20,'Body','Clipping',(#306));
#306=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#307,#312);
#307=IFCEXTRUDEDAREASOLID(#308,#309,#23,4100.);
#308=IFCRECTANGLEPROFILEDEF(.AREA.,$,#26,450.,300.);
#309=IFCAXIS2PLACEMENT3D(#310,#24,#311);
#310=IFCCARTESIANPOINT((0.,0.,-225.));
#311=IFCDIRECTION((0.,0.,-1.));
#312=IFCHALFSPACESOLID(#313,.F.);
#313=IFCPLANE(#314);
#314=IFCAXIS2PLACEMENT3D(#315,#24,$);
#315=IFCCARTESIANPOINT((0.,0.,4000.));
#320=IFCPROPERTYSINGLEVALUE('Mark',$,IFCTEXT('VR4'),$);
#321=IFCPROPERTYSET('2kM9yQ0aH1JfT0wqJxk3Sd',$,'Identity Data',$,(#320));
#322=IFCRELDEFINESBYPROPERTIES('0pQnW2xY5Hk8v6dJz1aB3c',$,$,$,(#300),#321);
#200=IFCRELCONTAINEDINSPATIALSTRUCTURE('3m9wd8$zH0dhsHNd4hS8Vx',$,$,$,(#110,#120,#150,#160,#180),#34);
#201=IFCRELCONTAINEDINSPATIALSTRUCTURE('0w5H2Nnp53ShO1vbF1M1Yh',$,$,$,(#100,#130,#190,#300),#36);
#202=IFCRELCONTAINEDINSPATIALSTRUCTURE('1fGQ4tB8f0YQp3Wl7DG2Lc',$,$,$,(#170),#32);
